# Set by Vercel automatically for Git deployments; use AORA_DEPLOY_ENV locally.
AORA_DEPLOY_ENV=preview

# Preview/Staging project. Production must use a different project ref.
AORA_SUPABASE_URL=https://xqgkawskftzurbujrpex.supabase.co
AORA_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# All generated public links use this stable origin, never an immutable preview URL.
AORA_CANONICAL_ORIGIN=https://dopamine-mobins-projects-4f428afa.vercel.app

# Edge Function routing. Keep environment-specific values in Vercel, not source.
AORA_ACCESS_FUNCTION=aora-v8-pilot-access
AORA_WORKSPACE_FUNCTION=aora-v8-pilot-workspace-rules
AORA_KIOSK_FUNCTION=aora-v8-pilot-kiosk
AORA_COMPLIANCE_FUNCTION=aora-v8-pilot-compliance
AORA_MONITOR_FUNCTION=aora-v8-pilot-monitor
AORA_ONBOARDING_FUNCTION=aora-v8-pilot-onboarding
AORA_REALTIME_BROADCAST_FUNCTION=aora-v8-pilot-realtime-broadcast

# DATEV payroll integration.
# The values below belong in Supabase Edge Function secrets for each environment.
# Never put real credentials/tokens in this file, Vercel public env, browser storage, or Git.
AORA_DATEV_FUNCTION=aora-v8-datev-integration
DATEV_CLIENT_ID=replace-with-datev-developer-portal-client-id
DATEV_CLIENT_SECRET=replace-with-datev-developer-portal-client-secret
DATEV_REDIRECT_URI=https://xqgkawskftzurbujrpex.supabase.co/functions/v1/aora-v8-datev-integration/callback
AORA_DATEV_RETURN_URL=https://dopamine-blond.vercel.app/inhaber/
# Base64-encoded 32 random bytes; Supabase secret only.
AORA_DATEV_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Pin service base URLs to the subscribed DATEV OpenAPI environment values.
DATEV_HR_FILES_BASE_URL_SANDBOX=replace-from-subscribed-datev-openapi
DATEV_HR_FILES_BASE_URL_PRODUCTION=replace-from-subscribed-datev-openapi
DATEV_HR_EXCHANGE_BASE_URL_SANDBOX=https://hr-exchange.api.datev.de/platform-sandbox/v1/
DATEV_HR_EXCHANGE_BASE_URL_PRODUCTION=https://hr-exchange.api.datev.de/platform/v1/

# Provider writes stay off until the subscribed OpenAPI DTOs are pinned and contract-tested.
DATEV_HR_FILES_UPLOAD_ENABLED=false
DATEV_HR_EXCHANGE_WRITES_ENABLED=false
